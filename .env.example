# Authentication
# Generate a random secret: https://generate-secret.vercel.app/32 or `openssl rand -base64 32`
AUTH_SECRET=****

# Database connectivity
# PostgreSQL connection string used by Drizzle migrations, seeds, and runtime queries.
POSTGRES_URL=****

# Storage providers
# Instructions to create a Vercel Blob Store: https://vercel.com/docs/storage/vercel-blob
BLOB_READ_WRITE_TOKEN=****

# Redis cache (optional for rate limiting / session caching)
# Instructions: https://vercel.com/docs/redis
REDIS_URL=****

# AI configuration
# AI Gateway API Key (required for non-Vercel deployments)
# For Vercel deployments, OIDC tokens are used automatically
AI_GATEWAY_API_KEY=****
# OpenAI credentials used by the finance agent – ensure the model ID matches an available deployment.
OPENAI_API_KEY=****
OPENAI_MODEL_ID=gpt-4.1-mini

# External market/news providers (mocked in tests if unset)
MARKET_DATA_API_KEY=****
MARKET_DATA_API_BASE_URL=https://example-data-provider.test/v1/
NEWS_API_KEY=****

# Feature flags
# Toggle to enable the finance artefacts end-to-end.
FEATURE_FINANCE=true
# Opt-in to the HTTP market data adapter. Requires MARKET_DATA_API_KEY and MARKET_DATA_API_BASE_URL.
FEATURE_USE_REAL_DATA=false

# Test automation
# When set to "true", the rate limiter bypasses quota checks and Playwright fixtures become deterministic.
PLAYWRIGHT=true
# Mirror the server-side flag inside the browser bundle so finance artefacts remain available during e2e runs.
NEXT_PUBLIC_FEATURE_FINANCE=true
